NODE_ENV=development
PORT=6000
LOG_LEVEL=info
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://egliseapc:change-me@localhost:5432/egliseapc
REDIS_URL=redis://:change-me@localhost:6379
INTEGRATION_API_KEY=development-only-change-this-api-key
MEDIA_STORAGE_PATH=./uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:6000/media
MEDIA_MAX_FILE_SIZE_BYTES=5242880
MEDIA_MAX_INPUT_PIXELS=40000000
MEDIA_UPLOAD_RATE_LIMIT=30
MEDIA_PUBLIC_CACHE_SECONDS=31536000

# Valeurs lues par Docker Compose uniquement.
POSTGRES_DB=egliseapc
POSTGRES_USER=egliseapc
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me
REDIS_PORT=6379
API_PORT=6000
API_BIND_ADDRESS=127.0.0.1
