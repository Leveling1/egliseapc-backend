NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://egliseapc:change-me@localhost:5432/egliseapc
REDIS_URL=redis://:change-me@localhost:6379
MEDIA_STORAGE_PATH=./uploads

# Valeurs lues par Docker Compose uniquement.
POSTGRES_DB=egliseapc
POSTGRES_USER=egliseapc
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me
REDIS_PORT=6379
API_PORT=3000
API_BIND_ADDRESS=127.0.0.1
